# ==========================================
# TimeFlow ERP - Environment Variables
# ==========================================

# --- API Environment ---
NODE_ENV="development"
PORT=8080

# --- Database (PostgreSQL via Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/timeflow_db?schema=public"

# --- Redis Cache ---
REDIS_URL="redis://localhost:6379"

# --- Frontend Web ---
# Public URL for the frontend to communicate with the backend API
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# --- Security / Authentication ---
# Run `openssl rand -base64 32` to generate a secure secret
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
