{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom", "dom.iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "composite": true,
    "paths": {
      "@timeflow/ui": ["../../packages/ui/src"],
      "@timeflow/types": ["../../packages/types/src"],
      "@timeflow/utils": ["../../packages/utils/src"],
      "@timeflow/validation": ["../../packages/validation/src"],
      "@timeflow/config/*": ["../../packages/config/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
