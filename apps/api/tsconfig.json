    "src/middlewares/security-shield.middleware.ts",
    "src/modules/allocation-engine/allocation-engine.service.ts",
    "src/modules/appointment/appointment.controller.ts",
    "src/modules/appointment/appointment.routes.ts",
    "src/modules/appointment/appointment.service.ts",
    "src/modules/appointment/billing-review.controller.ts",
    "src/modules/appointment/billing-review.routes.ts",
    "src/modules/appointment/billing-review.service.ts",
