    "src/modules/appointment/ready-for-billing.routes.ts",
    "src/modules/appointment/ready-for-billing.service.ts",
    "src/modules/appointment/schemas/appointment.schema.ts",
    "src/modules/appointment/schemas/billing-review.schema.ts",
    "src/modules/appointment/schemas/ready-for-billing.schema.ts",
